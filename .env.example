# SQLite file (created on first start). In the container this is /data/poker.db.
DATABASE_URL=local.db

# Header Pangolin uses to forward the signed-in user's email. Check your Pangolin version's docs.
AUTH_EMAIL_HEADER=remote-email

# Local dev only: act as this user when the header is missing. Ignored outside `npm run dev`.
DEV_USER=you@example.com
